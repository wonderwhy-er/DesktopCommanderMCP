{
  "all": true,
  "include": [
    "src/**",
    "setup-claude-server.js",
    "uninstall-claude-server.js",
    "track-installation.js",
    "vendor/telemetry-contract/**"
  ],
  "exclude": [
    "**/*.d.ts",
    "vendor/**/*.test.js"
