# Internal connector pilot only. Export these values before starting the device.
# This file is a template; the connector does not automatically load .env files.
MCP_SERVER_URL=
# Optional absolute path: isolate test device identities without changing HOME.
MCP_DEVICE_CONFIG_PATH=
# Only literal true enables MQTT. Blank leaves existing Supabase transport unchanged.
MQTT_TRANSPORT_ENABLED=
# False/unset: receive MQTT for comparison, execute only Broadcast. True: execute only MQTT.
# Ignored when transport is disabled. Flags are read at connector startup.
MQTT_EXECUTION_ENABLED=
# MQTT always generates a local key and enrolls through the authenticated backend,
# or reuses the certificate cached beside the profile. No device AWS keys are needed.
# Literal true permits loopback HTTP enrollment (including mcp.localhost).
# AWS MQTT still uses TLS with certificate verification.
MQTT_ALLOW_INSECURE_LOCAL=
# Optional custom CA bundle; default uses Node's trusted CA roots.
MQTT_CA_FILE=
